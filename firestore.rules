rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Match documents in "users" collection
    match /users/{userId} {
      // Allow read and write access to only the user's corresponding doc
     allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read access for Purdue API data collections
    match /buildings/{document=**} {
      allow read: if true;
    }
    match /campuses/{document=**} {
      allow read: if true;
    }
    match /classes/{document=**} {
      allow read: if true;
    }
    match /courses/{document=**} {
      allow read: if true;
    }
    match /instructors/{document=**} {
      allow read: if true;
    }
    match /meetings/{document=**} {
      allow read: if true;
    }
    match /rooms/{document=**} {
      allow read: if true;
    }
    match /sections/{document=**} {
      allow read: if true;
    }
    match /subjects/{document=**} {
      allow read: if true;
    }
    match /terms/{document=**} {
      allow read: if true;
    }
  }
}
